{
  "name": "whatwg-mimetype",
  "version": "5.0.0",
  "description": "Parses, serializes, and manipulates MIME types, according to the WHATWG MIME Sniffing Standard",
  "keywords": [
    "content-type",
    "http",
    "mime type",
    "mimesniff",
    "whatwg"
  ],
  "license": "MIT",
  "author": "Domenic Denicola <d@domenic.me> (https://domenic.me/)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jsdom/whatwg-mimetype.git"
  },
  "files": [
    "lib/"
  ],
  "main": "lib/index.js",
  "scripts": {
    "test": "node --test",
    "coverage": "c8 node --test --experimental-test-coverage",
    "check": "npm run lint && npm run fmt:check",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "pretest": "node scripts/get-latest-platform-tests.mjs"
  },
  "devDependencies": {
    "@domenic/eslint-config": "^6.0.0",
    "@exodus/bytes": "^1.9.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "c8": "^10.1.3",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "oxfmt": "0.75.0",
    "printable-string": "^0.3.0"
  },
  "c8": {
    "exclude": [
      "scripts/",
      "test/"
    ],
    "reporter": [
      "html"
    ]
  },
  "engines": {
    "node": "^22.14.0 || >=24.0.0"
  }
}
